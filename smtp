#!/bin/bash

# Exit on error, unset variables, or pipe failures
set -euo pipefail

# Log file for debugging
LOG_FILE="/var/log/setup_script.log"
log() { echo "$(date): $1" | tee -a "$LOG_FILE"; }

# Function to check if a command exists
command_exists() { command -v "$1" &>/dev/null; }

# Function to clean up
cleanup() {
    if [ -d "emil" ]; then
        rm -rf emil
        log "Cleaned up repository."
    fi
}

# Trap errors or script exit to ensure cleanup
trap 'log "Script terminated."; cleanup' EXIT

log "Starting script execution."

# Install git
if command_exists dnf; then
    log "Installing git using dnf."
    sudo dnf install git -y
elif command_exists apt; then
    log "Installing git using apt."
    sudo apt update
    sudo apt install git -y
elif command_exists pacman; then
    log "Installing git using pacman."
    sudo pacman -S --noconfirm git
elif command_exists zypper; then
    log "Installing git using zypper."
    sudo zypper install -y git
else
    log "Unsupported package manager. Please install git manually."
    exit 1
fi

# Install net-tools based on OS
if [ -f /etc/os-release ]; then
    . /etc/os-release
    log "Detected OS: $ID"
    case "$ID" in
        ubuntu|debian)
            sudo apt update && sudo apt install -y net-tools || log "Failed to install net-tools on $ID."
            ;;
        centos|rocky)
            sudo yum install -y net-tools || log "Failed to install net-tools on $ID."
            ;;
        fedora|rhel)
            sudo dnf install -y net-tools || log "Failed to install net-tools on $ID."
            ;;
        arch|manjaro)
            sudo pacman -S --noconfirm net-tools || log "Failed to install net-tools on $ID."
            ;;
        opensuse*|suse)
            sudo zypper install -y net-tools || log "Failed to install net-tools on $ID."
            ;;
        *)
            log "Unsupported OS for net-tools installation. Skipping..."
            ;;
    esac
else
    log "Cannot determine OS. Skipping net-tools installation."
fi

# Create user
USER_NAME="farooq"
USER_PASSWORD="ALLAH@786"
log "Setting up user: $USER_NAME"

if id "$USER_NAME" &>/dev/null; then
    log "User '$USER_NAME' already exists."
else
    log "Creating user '$USER_NAME'."
    sudo useradd -m -s /bin/bash "$USER_NAME"
    echo "$USER_NAME:$USER_PASSWORD" | sudo chpasswd

    # Add to appropriate admin group
    if command_exists usermod; then
        if getent group wheel >/dev/null; then
            sudo usermod -aG wheel "$USER_NAME"
            log "Added $USER_NAME to wheel group."
        elif getent group sudo >/dev/null; then
            sudo usermod -aG sudo "$USER_NAME"
            log "Added $USER_NAME to sudo group."
        fi
    else
        log "Cannot add user to admin group; usermod not found."
        exit 1
    fi

    # Configure sudoers for the user (require password for sudo)
    SUDOERS_FILE="/etc/sudoers.d/$USER_NAME"
    echo "$USER_NAME ALL=(ALL) ALL" | sudo tee "$SUDOERS_FILE" >/dev/null
    sudo chmod 440 "$SUDOERS_FILE"
    log "Configured sudoers for $USER_NAME."
fi

# Clone repository
log "Cloning repository."
if ! git clone https://github.com/farooq-001/emil.git; then
    log "Failed to clone repository."
    exit 1
fi

# Set permissions on .iplist.txt (assuming it should be in user's home or repo)
IPLIST_FILE="/home/$USER_NAME/.iplist.txt"
if [ -f "$IPLIST_FILE" ]; then
    log "Setting permissions on $IPLIST_FILE."
    sudo chmod 644 "$IPLIST_FILE"
else
    log "Warning: $IPLIST_FILE does not exist. Skipping chmod."
fi

# Run Python script
if command_exists python3; then
    if [ -f "emil/ip.py" ]; then
        log "Running Python script emil/ip.py."
        if ! sudo python3 emil/ip.py; then
            log "Python script failed."
            exit 1
        fi
    else
        log "Python script emil/ip.py not found."
        exit 1
    fi
else
    log "Python 3 is not installed. Please install Python 3."
    exit 1
fi

# Cleanup handled by trap

log "$USER Script completed successfully."
